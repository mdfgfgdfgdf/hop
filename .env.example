# ─────────────────────────────────────────────────────────────────────────────
# HOP — environment template. Copy to .env.local for development.
# Never commit real secrets. All values below are development defaults.
# ─────────────────────────────────────────────────────────────────────────────

# Database.
#   - Leave empty (or "pglite://./data/hop") to use the embedded PGlite Postgres
#     engine stored on disk. Zero setup, same SQL as production.
#   - "memory://" uses an in-memory database (used by the test suite).
#   - "postgres://user:pass@host:5432/hop" uses a real PostgreSQL server
#     (see docker-compose.yml).
DATABASE_URL=pglite://./data/hop

# Run pending migrations automatically when the server starts (dev default).
DB_AUTO_MIGRATE=true

# Seed baseline data (service types, demo tariff, service area, admin) on boot.
DB_AUTO_SEED=true

# Demo mode: seeds demo riders/drivers, enables the driver simulator and shows
# a visible "DEMO" banner. Demo data is never presented as real data.
HOP_DEMO_MODE=true

# Secret used to sign/derive session material. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HOP_SESSION_SECRET=dev-only-change-me-0000000000000000000000000000

# Bootstrap admin (created by the seed if it does not exist). Change in prod.
HOP_ADMIN_EMAIL=admin@hop.local
HOP_ADMIN_PASSWORD=Admin1234!

# Geo provider (server side):
#   "osm"  — live map data: Photon search, Nominatim reverse geocoding, OSRM road routing.
#            No API keys. If a service is unreachable the app falls back to the offline
#            estimate for that call and labels it as estimated.
#   "demo" — offline only (seeded Israeli places + estimated routes); used by the test suite.
GEO_PROVIDER=osm
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
# OSM services require a contact in the User-Agent. Use a real address in production.
HOP_GEO_CONTACT=ops@hop.local

# Live traffic (optional, server-side keys; never NEXT_PUBLIC_). With a key, quotes, ETAs and
# driver navigation use traffic-aware routes and the route is coloured by congestion.
#   ROUTING_PROVIDER=auto picks the first key present: Google → Mapbox → TomTom → OSRM (no traffic).
#   Google: enable "Routes API" on the key.  Mapbox: a token with Directions access.
#   TomTom: Routing + Traffic Flow; also powers the live traffic overlay on the map
#   (tiles are proxied by /api/map/traffic so the key stays on the server).
# Restrict keys by API and by server IP in each provider's console.
ROUTING_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
TOMTOM_API_KEY=
TRAFFIC_TILES=auto

# Map tiles for the browser (MapLibre style URL). OpenFreeMap needs no key.
# "positron" is the light blue-and-white base. Leave empty to always use "HOP City", the
# schematic offline 3D map (also used automatically when tiles cannot be reached).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Where uploaded driver documents are stored (local disk for development).
HOP_DATA_DIR=./data

# Rate limiting (auth, quotes, geocoding, uploads). "off" is for automated e2e test
# servers only — never on a real deployment.
# HOP_RATE_LIMIT=on

# App URL (used in links / e2e tests)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Playwright: path to a pre-installed Chromium binary (optional; otherwise run
# `pnpm exec playwright install chromium`).
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium
