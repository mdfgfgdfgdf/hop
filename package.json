{
  "name": "hop",
  "version": "0.1.0",
  "private": true,
  "description": "HOP — on-demand transportation platform for Israel (rider app, driver app, operator dashboard)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
